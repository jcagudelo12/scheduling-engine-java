<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sched</groupId>
        <artifactId>sched-engine</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>sched-server</artifactId>
    <description>Aplicación Spring Boot: instancia los adaptadores y los inyecta en los casos de uso.</description>

    <dependencies>
        <dependency><groupId>sched</groupId><artifactId>sched-application</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-solver</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-gateway-http</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-grpc-catalog</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-grpc-events</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-nats-bus</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <!-- Métricas y administración: solo aquí; el núcleo no depende de Micrometer. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
        <dependency><groupId>io.nats</groupId><artifactId>jnats</artifactId></dependency>
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-netty-shaded</artifactId></dependency>
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-services</artifactId></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-in-memory</artifactId><scope>test</scope></dependency>
        <!-- Pruebas: MockMvc, @SpringBootTest (extremo a extremo) y Testcontainers con NATS real. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>sched-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- El ejecutable es sched-server-exec.jar; el jar normal (sched-server.jar) queda como
                         dependencia utilizable por quality/ (ArchUnit y cobertura agregada). -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- jnats trae bcprov-lts8on con las mismas clases org.bouncycastle que bcpkix-jdk18on
                         (solo de prueba): en las pruebas, que no usan NATS, se deja fuera para que no choquen. -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.bouncycastle:bcprov-lts8on</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
