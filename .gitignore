# Compilación de Maven
target/

# Resultados crudos de la prueba de carga (se regeneran con bench/run.sh)
bench/scenario.json
bench/students.json
bench/alternatives.json
bench/worst.json
bench/worst-hot.json
bench/drain.txt
bench/results*/*.json
bench/results*/*.txt
# Reporte HTML del panel web de k6 (K6_DASHBOARD=1); los HTML de perfilado en results/profile/ sí se versionan
bench/results*/*_k6_dashboard.html
bench/.venv/
__pycache__/

# Resultados crudos del experimento (los md y los json de resumen de simulation/experiments/ sí se versionan)
simulation/experiments/**/results.csv

# Catálogo de demostración generado (simulator demo-catalog)
simulation/fixtures/demo.json

# Salida de JMH ejecutado sin -rff
jmh-result.*

# Secretos de desarrollo del despliegue (los generan deploy/setup-dev.sh y deploy/certs/generate.sh)
deploy/certs/*
!deploy/certs/generate.sh
deploy/keys/
deploy/.env

# IDE
.idea/
*.iml
.jqwik-database
