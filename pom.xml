<?xml version="1.0" encoding="UTF-8"?>
<!--
  Motor de validación previa de horarios.
  Arquitectura hexagonal: un módulo por capa, con las dependencias hacia adentro (ADR 0001).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>sched</groupId>
    <artifactId>sched-engine</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>domain</module>
        <module>solver</module>
        <module>application</module>
        <module>proto</module>
        <module>adapters/in-memory</module>
        <module>adapters/grpc-catalog</module>
        <module>adapters/grpc-events</module>
        <module>adapters/nats-bus</module>
        <module>adapters/gateway-http</module>
        <module>server</module>
        <module>simulation</module>
        <module>benchmarks</module>
        <!-- Al final: pruebas de arquitectura y reporte agregado de cobertura (ver quality/pom.xml). -->
        <module>quality</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <grpc.version>1.84.0</grpc.version>
        <protobuf.version>4.36.2</protobuf.version>
        <jnats.version>2.26.3</jnats.version>
        <jmh.version>1.37</jmh.version>
        <jqwik.version>1.10.2</jqwik.version>
        <commons-statistics.version>1.3</commons-statistics.version>
        <!-- bcprov: Ed25519 de la verificación del token (ADR 0004); bcpkix, solo en pruebas: generar CA y certificados X.509 (mTLS del gRPC de ingesta). -->
        <bouncycastle.version>1.87</bouncycastle.version>
        <!-- Pruebas de integración con NATS JetStream real (se saltan sin Docker). -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- Reglas de arquitectura (quality/). -->
        <archunit.version>1.5.1</archunit.version>
        <jacoco.version>0.8.16</jacoco.version>
        <!--
          Cobertura mínima de líneas por módulo; solo la exigen los del núcleo (domain, solver,
          application), que la suben en su pom. 0 = no se exige. Ver CONTRIBUTING.md.
        -->
        <jacoco.line.min>0.00</jacoco.line.min>
        <jacoco.branch.min>0.00</jacoco.branch.min>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Módulos internos -->
            <dependency><groupId>sched</groupId><artifactId>sched-domain</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-solver</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-application</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-proto</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-in-memory</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-grpc-catalog</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-grpc-events</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-nats-bus</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-gateway-http</artifactId><version>${project.version}</version></dependency>

            <!-- Externos -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>io.nats</groupId>
                <artifactId>jnats</artifactId>
                <version>${jnats.version}</version>
                <!--
                  jnats declara bcprov-lts8on pero no usa ninguna clase de BouncyCastle (se comprobó en su jar).
                  Trae las mismas clases org.bouncycastle que bcprov-jdk18on, que ahora usa el adaptador HTTP
                  para Ed25519 (ADR 0004): con las dos en el classpath chocarían, y los jar firmados no se mezclan.
                -->
                <exclusions>
                    <exclusion><groupId>org.bouncycastle</groupId><artifactId>bcprov-lts8on</artifactId></exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-statistics-inference</artifactId>
                <version>${commons-statistics.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-statistics-distribution</artifactId>
                <version>${commons-statistics.version}</version>
            </dependency>
            <!-- Las tres a la misma versión: Spring Boot gestiona otra para bcprov y no casan. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
              Cobertura (JaCoCo) en todos los módulos con pruebas: el agente mide, "report" escribe
              target/site/jacoco y "check" hace fallar verify si un módulo del núcleo baja de su
              umbral (jacoco.line.min en el pom del módulo). El código generado de protobuf no cuenta.
              El reporte agregado de todos los módulos lo produce quality/.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>sched/proto/engine/**</exclude>
                        <exclude>sched/proto/institution/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
