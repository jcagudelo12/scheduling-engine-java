<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sched</groupId>
        <artifactId>sched-engine</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>sched-simulation</artifactId>
    <description>
        Simulación e institución simulada: corre escenarios en memoria y habla con el motor por
        el contrato gRPC real, como lo haría el SDK de la institución.
        Ejecutar: java -jar simulation/target/sched-simulation.jar
    </description>

    <dependencies>
        <dependency><groupId>sched</groupId><artifactId>sched-application</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-solver</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-proto</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-in-memory</artifactId></dependency>
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-netty-shaded</artifactId></dependency>
        <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><scope>runtime</scope></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <!-- Reemplaza la configuración de shade que trae spring-boot-starter-parent. -->
                        <configuration combine.self="override">
                            <finalName>sched-simulation</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>sched.simulation.Main</mainClass>
                                    <manifestEntries>
                                        <!-- Netty (gRPC) carga librerías nativas; Java 22+ lo exige explícito. -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <!-- gRPC registra sus transportes y resolutores en META-INF/services. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
