# Variables del despliegue de desarrollo. deploy/setup-dev.sh crea deploy/.env a partir de este
# archivo y genera la contraseña de NATS. deploy/.env NO se versiona.

# Contraseña del usuario "engine" de NATS (la genera setup-dev.sh; debe empezar con una letra).
NATS_ENGINE_PASSWORD=cambiar-por-una-contrasena-larga-y-aleatoria

# Contraseña del usuario "admin" de Grafana, perfil "observability" (la genera setup-dev.sh).
GRAFANA_ADMIN_PASSWORD=cambiar-por-una-contrasena-larga-y-aleatoria

# Emisor y audiencia que deben llevar los tokens (SCHED_JWT_ISSUER, SCHED_JWT_AUDIENCE).
SCHED_JWT_ISSUER=institucion-dev
SCHED_JWT_AUDIENCE=sched-engine

# Traefik, por IP de origen: solicitudes por segundo sostenidas, ráfaga y solicitudes simultáneas.
RATE_LIMIT_AVERAGE=50
RATE_LIMIT_BURST=100
INFLIGHT_MAX=100
# Tamaño máximo del cuerpo HTTP en bytes (igual que SCHED_MAX_BODY_BYTES del motor).
MAX_BODY_BYTES=65536
